import os
import sys
import shutil
import subprocess
import argparse
import platform
from pathlib import Path

# Configuration
CONFIG_DIR = Path.home() / ".config" / "linsys2"
DATA_DIR = Path.home() / ".local" / "share" / "linsys2"

# Derive private prefix from wrapper location.
# Wrapper is at <prefix>/bin/linsys2-makepkg
# Private prefix is <prefix>/lib/linsys2-pacman
_BINDIR = Path(__file__).resolve().parent
_PRIVATE_PREFIX = _BINDIR.parent / "lib" / "linsys2-pacman"
MAKEPKG_BIN = _PRIVATE_PREFIX / "bin" / "makepkg"
PACMAN_CONF_BIN = _PRIVATE_PREFIX / "bin" / "pacman-conf"
LINSYS2_PACMAN_BIN = _BINDIR / "linsys2-pacman"
MAKEPKG_CONF = _PRIVATE_PREFIX / "etc" / "makepkg_linsys2.conf"
LIBALPM_DIR = _PRIVATE_PREFIX / "lib"
LIBMAKEPKG_DIR = _PRIVATE_PREFIX / "share" / "makepkg"

# Marker placed in generated wrapper scripts so stale ones can be cleaned up
WRAPPER_MARKER = "# generated by linsys2-makepkg"

# cygpath(1) shim mapping between Linux paths and the Wine "Windows"
# view (Z: maps to /); used by libtool/configure path conversion.
CYGPATH_SHIM = r'''#!/usr/bin/env python3
# generated by linsys2-makepkg
import os
import sys

def to_unix(path):
    if len(path) >= 3 and path[1] == ":" and path[2] in "\\/":
        drive = path[0].upper()
        rest = path[2:].replace("\\", "/")
        if drive == "Z":
            return rest
        wineprefix = os.environ.get("WINEPREFIX", "")
        return wineprefix + "/drive_" + drive.lower() + rest
    return path.replace("\\", "/")

def to_windows(path, mixed=False):
    if len(path) >= 3 and path[1] == ":" and path[2] in "\\/":
        win = path
    elif path.startswith("/"):
        win = "Z:" + path
    else:
        win = path
    return win.replace("\\", "/") if mixed else win.replace("/", "\\")

def main():
    mode = "unix"
    absolute = False
    path_list = False
    paths = []
    for arg in sys.argv[1:]:
        if arg.startswith("--"):
            if arg == "--help":
                print("usage: cygpath [-w|-u|-m] [-a] [-p] PATH...")
                sys.exit(0)
            if arg == "--version":
                print("cygpath (linsys2 shim) 1.0")
                sys.exit(0)
            long_opts = {"--windows": "w", "--unix": "u", "--mixed": "m",
                         "--absolute": "a", "--path": "p",
                         "--long-name": "l", "--short-name": "s"}
            if arg not in long_opts:
                sys.exit(f"cygpath: unsupported option {arg}")
            flags = long_opts[arg]
        elif arg.startswith("-") and len(arg) > 1:
            flags = arg[1:]
        else:
            paths.append(arg)
            continue
        for f in flags:
            if f in "wum":
                mode = {"w": "windows", "u": "unix", "m": "mixed"}[f]
            elif f == "a":
                absolute = True
            elif f == "p":
                path_list = True
            elif f in "ls":
                pass  # -l/-s only affect 8.3 names; irrelevant under Wine
            else:
                sys.exit(f"cygpath: unsupported option -{f}")

    def convert(p):
        if absolute:
            p = os.path.abspath(p)
        if mode == "unix":
            return to_unix(p)
        return to_windows(p, mixed=(mode == "mixed"))

    for p in paths:
        if path_list:
            if mode == "unix":
                print(":".join(convert(e) for e in p.split(";") if e))
            else:
                print(";".join(convert(e) for e in p.split(":") if e))
        else:
            print(convert(p))

main()
'''

# Supported environments (must match linsys2-pacman)
ENVIRONMENTS = {
    "ucrt64": {
        "prefix": "mingw-w64-ucrt-x86_64",
        "install_prefix": "/ucrt64",
        "msystem": "UCRT64",
        "chost": "x86_64-w64-mingw32",
    },
    "clang64": {
        "prefix": "mingw-w64-clang-x86_64",
        "install_prefix": "/clang64",
        "msystem": "CLANG64",
        "chost": "x86_64-w64-mingw32",
    },
    "clangarm64": {
        "prefix": "mingw-w64-clang-aarch64",
        "install_prefix": "/clangarm64",
        "msystem": "CLANGARM64",
        "chost": "aarch64-w64-mingw32",
    },
}

# Auto-detect default environment based on host architecture
_machine = platform.machine().lower()
if _machine in ("aarch64", "arm64"):
    DEFAULT_ENV = "clangarm64"
else:
    DEFAULT_ENV = "ucrt64"


def _get_version():
    v = "@VERSION@"
    return v if not v.startswith("@") else "development"


def info(msg):
    print(f"\033[0;32m[INFO]\033[0m {msg}")


def warn(msg):
    print(f"\033[1;33m[WARN]\033[0m {msg}")


def error(msg):
    print(f"\033[0;31m[ERROR]\033[0m {msg}", file=sys.stderr)


def get_env_dir(env_name):
    return DATA_DIR / env_name


def get_bin_dir(env_name):
    """Get the Windows bin directory for an environment."""
    env_cfg = ENVIRONMENTS[env_name]
    env_dir = get_env_dir(env_name)
    return env_dir / env_cfg["install_prefix"].lstrip("/") / "bin"


def get_wineprefix(env_name):
    return get_env_dir(env_name) / "wine"


def get_build_bin_dir(env_name):
    return get_env_dir(env_name) / "build-bin"


def winepath_of_bin_dir(env_name):
    """Windows view of the environment's bin directory (Z: maps to /)."""
    return "Z:" + str(get_bin_dir(env_name)).replace("/", "\\")


def _write_if_changed(path, content, mode=0o755):
    if path.exists() and path.read_text() == content:
        return
    path.write_text(content)
    path.chmod(mode)


def ensure_wineprefix(env_name):
    """Create the environment's Wine prefix if missing."""
    wineprefix = get_wineprefix(env_name)

    if not (wineprefix / "dosdevices").is_dir():
        info(f"Initializing Wine prefix: {wineprefix}")
        wineprefix.mkdir(parents=True, exist_ok=True)
        env = os.environ.copy()
        env["WINEPREFIX"] = str(wineprefix)
        env["WINEDLLOVERRIDES"] = "winemenubuilder.exe=d"
        env["WINEDEBUG"] = "-all"
        result = subprocess.run(["wineboot", "--init"], env=env, check=False)
        if result.returncode != 0:
            warn("wineboot failed; prefix may be incomplete")


def ensure_tool_links(env_name):
    """Link every foo.exe in the bin dir as plain `foo`, so shell logic can
    invoke the Windows tools by name (binfmt_misc + Wine, like an MSYS2
    shell resolving gcc -> gcc.exe).

    The links must sit next to their .exe: Wine reports the opened path as
    the module path, which drives both the DLL search order and
    self-located resources (GCC's specs, CMake's Modules). Only the exact
    generated pattern (`foo` -> `foo.exe`, relative) is created or pruned.
    """
    bin_dir = get_bin_dir(env_name)
    if not bin_dir.is_dir():
        return

    for exe in sorted(bin_dir.iterdir()):
        name = exe.name
        if not name.lower().endswith(".exe"):
            continue
        link = bin_dir / name[:-4]
        if not link.name or os.path.lexists(link):
            continue
        try:
            link.symlink_to(name)
        except OSError:
            pass

    # Prune dangling generated links (their package was removed)
    for entry in bin_dir.iterdir():
        if not entry.is_symlink():
            continue
        try:
            target = os.readlink(entry)
        except OSError:
            continue
        if "/" not in target and target == entry.name + ".exe" \
                and not (bin_dir / target).exists():
            try:
                entry.unlink()
            except OSError:
                pass


def ensure_build_bin(env_name):
    """Generate the build shim directory: pacman/pacman-conf shims pointing
    at the environment's pacman config, the cygpath shim, and wrappers for
    .bat/.cmd tools (which binfmt_misc cannot handle).
    """
    build_bin = get_build_bin_dir(env_name)
    build_bin.mkdir(parents=True, exist_ok=True)

    wineprefix = get_wineprefix(env_name)
    bin_dir = get_bin_dir(env_name)

    exports = (
        f"export WINEPREFIX='{wineprefix}'\n"
        f"export WINEDEBUG=-all\n"
    )

    bat_targets = set()
    if bin_dir.is_dir():
        for script in sorted(bin_dir.iterdir()):
            name = script.name
            if not name.lower().endswith((".bat", ".cmd")):
                continue
            wrapper_name = name.rsplit(".", 1)[0]
            if not wrapper_name:
                continue
            bat_targets.add(wrapper_name)
            _write_if_changed(
                build_bin / wrapper_name,
                f"#!/bin/sh\n{WRAPPER_MARKER}\n{exports}"
                f"exec wine cmd /c '{script}' \"$@\"\n",
            )

    # Remove stale .bat/.cmd wrappers
    for wrapper in build_bin.iterdir():
        if wrapper.name in ("pacman", "pacman-conf", "cygpath"):
            continue
        if wrapper.name not in bat_targets and wrapper.is_file():
            try:
                if WRAPPER_MARKER in wrapper.read_text():
                    wrapper.unlink()
            except OSError:
                pass

    env_conf = CONFIG_DIR / f"{env_name}.conf"
    _write_if_changed(
        build_bin / "pacman",
        f"#!/bin/sh\n{WRAPPER_MARKER}\n"
        f"exec '{LINSYS2_PACMAN_BIN}' --env {env_name} \"$@\"\n",
    )
    _write_if_changed(
        build_bin / "pacman-conf",
        f"#!/bin/sh\n{WRAPPER_MARKER}\n"
        f"exec '{PACMAN_CONF_BIN}' --config '{env_conf}' \"$@\"\n",
    )
    # cygpath shim for libtool/configure path conversion
    _write_if_changed(build_bin / "cygpath", CYGPATH_SHIM)


def binfmt_registered():
    """Check whether binfmt_misc has an enabled registration for PE
    (MZ) binaries."""
    binfmt = Path("/proc/sys/fs/binfmt_misc")
    if not binfmt.is_dir():
        return False
    try:
        for entry in binfmt.iterdir():
            if entry.name in ("register", "status"):
                continue
            try:
                content = entry.read_text()
            except OSError:
                continue
            if "enabled" not in content.splitlines():
                continue
            for line in content.splitlines():
                # magic may be a literal "MZ" or its hex form "4d5a"
                if line.startswith("magic") and (
                        "MZ" in line or "4d5a" in line.lower()):
                    return True
    except OSError:
        pass
    return False


def check_binfmt():
    """binfmt_misc with an MZ->wine registration is required: the Windows
    build tools are executed directly by the kernel through it."""
    if binfmt_registered():
        return True
    wine = shutil.which("wine") or "/usr/bin/wine"
    error("binfmt_misc has no enabled PE (MZ) registration.")
    error("linsys2-makepkg runs Windows tools natively through the kernel's")
    error("binfmt_misc. Register Wine one time (requires root):")
    print(f"""
    sudo tee /etc/binfmt.d/linsys2-wine.conf <<'EOF'
    :DOSWin:M::MZ::{wine}:F
    EOF
    sudo systemctl restart systemd-binfmt
""")
    return False


def check_bwrap():
    """bubblewrap provides the private mount namespace that maps the
    environment's install prefix (/ucrt64, ...) into the build."""
    if shutil.which("bwrap"):
        return True
    error("bubblewrap (bwrap) not found.")
    error("linsys2-makepkg uses it to give the build a private filesystem")
    error("view with the environment prefix at /ucrt64. Install bubblewrap.")
    return False


def build_bwrap_argv(env_name, makepkg_cmd):
    """Assemble the bubblewrap command line running makepkg_cmd in a
    private mount namespace where the environment prefix is mounted at
    its MSYS2 location (/ucrt64, ...), so both native build scripts with
    the prefix baked in and Wine processes (Z: -> /) resolve it.
    """
    env_cfg = ENVIRONMENTS[env_name]
    install_prefix = env_cfg["install_prefix"]
    env_prefix = get_env_dir(env_name) / install_prefix.lstrip("/")

    argv = ["bwrap", "--unshare-user", "--unshare-pid", "--die-with-parent"]
    for top in sorted(os.listdir("/")):
        src = "/" + top
        if not os.path.isdir(src):
            continue
        if top == install_prefix.lstrip("/"):
            continue  # the environment prefix is mounted there below
        if os.path.islink(src):
            argv += ["--symlink", os.readlink(src), src]
        elif top == "proc":
            argv += ["--proc", "/proc"]
        elif top == "dev":
            argv += ["--dev", "/dev", "--tmpfs", "/dev/shm"]
        elif top in ("sys", "boot", "efi"):
            argv += ["--ro-bind", src, src]
        else:
            argv += ["--bind", src, src]
    argv += ["--dir", install_prefix,
             "--bind", str(env_prefix), install_prefix]
    argv += ["--", "bash", "-c",
             # Restart wineserver inside this namespace so its filesystem
             # view matches, and tear it down on exit.
             'wineserver -k 2>/dev/null; "$@"; rc=$?; '
             'wineserver -k 2>/dev/null; exit $rc',
             "bash"] + makepkg_cmd
    return argv


def run_makepkg(env_name, makepkg_args):
    """Run the private makepkg for one environment."""
    env_cfg = ENVIRONMENTS[env_name]
    env_conf = CONFIG_DIR / f"{env_name}.conf"

    if not MAKEPKG_BIN.exists():
        error(f"makepkg not found: {MAKEPKG_BIN}")
        return 1
    if not MAKEPKG_CONF.exists():
        error(f"makepkg config not found: {MAKEPKG_CONF}")
        return 1
    if not env_conf.exists():
        error(f"Environment {env_name} not initialized.")
        error(f"Run: linsys2-pacman init --env {env_name}")
        return 1
    if not check_binfmt():
        return 1
    if not check_bwrap():
        return 1

    ensure_wineprefix(env_name)
    ensure_tool_links(env_name)
    ensure_build_bin(env_name)

    env = os.environ.copy()
    env["MSYSTEM"] = env_cfg["msystem"]
    env["CHERE_INVOKING"] = "1"
    env["MSYS2_PACMAN_LINUX"] = "1"
    env["LINSYS2_ENV"] = env_name
    env["WINEPREFIX"] = str(get_wineprefix(env_name))
    env["WINEPATH"] = winepath_of_bin_dir(env_name)
    env["WINEDEBUG"] = "-all"
    env["PANGOCAIRO_BACKEND"] = "fontconfig"
    env["MAKEPKG_LIBRARY"] = str(LIBMAKEPKG_DIR)
    # gcc -print-prog-name=ld yields a Z:/... path that native bash cannot
    # execute; a bare name resolved via PATH makes libtool detect GNU ld
    # instead of falling back to its MSVC branch.
    env.setdefault("LD", "ld")
    # libtool validates gcc's library search paths with test -d, which fails
    # for the Z:/... forms; preseed the autoconf cache with the real
    # (in-namespace) prefix paths instead.
    prefix = env_cfg["install_prefix"]
    env.setdefault(
        "lt_cv_sys_lib_search_path_spec",
        f"{prefix}/lib {prefix}/{env_cfg['chost']}/lib /usr/lib /lib",
    )
    # depfiles would contain Z:\... paths that native GNU make (built
    # without HAVE_DOS_PATHS) cannot parse; one-shot package builds don't
    # need header dependency tracking.
    env.setdefault("am_cv_CC_dependencies_compiler_type", "none")
    env.setdefault("am_cv_CXX_dependencies_compiler_type", "none")
    if LIBALPM_DIR.exists():
        old = env.get("LD_LIBRARY_PATH")
        env["LD_LIBRARY_PATH"] = str(LIBALPM_DIR) + (":" + old if old else "")
    # build-bin holds the pacman/cygpath shims; the environment's bin dir
    # itself provides the Windows tools via binfmt_misc, mirroring MSYS2.
    env["PATH"] = ":".join([str(get_build_bin_dir(env_name)),
                            str(get_bin_dir(env_name)),
                            env.get("PATH", "")])

    cmd = [str(MAKEPKG_BIN), "--config", str(MAKEPKG_CONF)] + makepkg_args
    return subprocess.run(build_bwrap_argv(env_name, cmd), env=env).returncode


def main():
    argv = sys.argv[1:]

    if argv and argv[0] in ("-V", "--version"):
        print(f"linsys2-makepkg {_get_version()}")
        return 0

    env_choices = list(ENVIRONMENTS.keys())

    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--env", default=None, choices=env_choices,
                     help=f"target environment (default: {DEFAULT_ENV})")
    pre.add_argument("--refresh-tools", action="store_true",
                     help=argparse.SUPPRESS)  # internal: used by linsys2-pacman
    pre.add_argument("-h", "--help", action="store_true",
                     help="show this help message and exit")
    pre_args, makepkg_args = pre.parse_known_args(argv)

    if pre_args.refresh_tools:
        env_name = pre_args.env or DEFAULT_ENV
        ensure_tool_links(env_name)
        ensure_build_bin(env_name)
        return 0

    if pre_args.help:
        pre.print_help()
        print(f"""
Build MSYS2 mingw-w64 packages on Linux. All remaining arguments are
passed to makepkg. Examples:
  linsys2-makepkg -sLf              # build, installing mingw deps
  linsys2-makepkg --env clang64 -s  # build for clang64
  linsys2-makepkg --verifysource    # only verify sources

Environments: {', '.join(env_choices)} (default: {DEFAULT_ENV})
The MINGW_ARCH environment variable may hold a space-separated list of
environments to build for, like MSYS2's makepkg-mingw.
""")
        return 0

    # MINGW_ARCH (like MSYS2's makepkg-mingw) overrides --env
    mingw_arch = os.environ.get("MINGW_ARCH", "").split()
    if mingw_arch:
        envs = []
        for e in mingw_arch:
            e = e.lower()
            if e not in ENVIRONMENTS:
                error(f"MINGW_ARCH: '{e}' unknown, possible values: {env_choices}")
                return 1
            envs.append(e)
    else:
        envs = [pre_args.env or DEFAULT_ENV]

    ret = 0
    for env_name in envs:
        if len(envs) > 1:
            info(f"Building for {env_name}...")
        rc = run_makepkg(env_name, makepkg_args)
        if rc != 0:
            ret = rc
            break

    return ret


if __name__ == "__main__":
    sys.exit(main())
