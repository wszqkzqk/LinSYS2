#!/usr/bin/env python3
import sys
from pathlib import Path

_here = Path(__file__).resolve()
for _c in (_here.parent.parent / "lib" / "linsys2",   # installed: <prefix>/lib/linsys2
           _here.parent.parent / "python"):              # repo checkout
    if (_c / "linsys2").is_dir():
        sys.path.insert(0, str(_c))
        break

from linsys2.cli_linsys2 import main

sys.exit(main())
